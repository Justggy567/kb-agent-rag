# ============ 数据库 ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5433                 # 非标端口，避免和本机已有 PG 冲突
POSTGRES_DB=ragdb
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pwd_2026

# 只读账号：Text2SQL 执行 SQL 时专用，物理上无法写库
READONLY_USER=nw_readonly
READONLY_PASSWORD=nw_readonly_pwd

# ============ 模型 ============
# 生成：DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 向量化 + 重排：本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3                 # 1024 维，中英双语
EMBED_DIM=1024

# 重排后端：llm（默认，用 DeepSeek 打分，零额外依赖）| bge（本地 cross-encoder）| none
RERANK_BACKEND=llm
RERANK_TOP_N=5

# ============ 检索参数（评测时对比这三档）============
VECTOR_TOP_K=30
KEYWORD_TOP_K=30
RRF_K=60
RETRIEVE_TOP_K=6
GRADE_THRESHOLD=0.35               # Rerank 归一化分数低于此值触发重试

# ============ 其他 ============
UPLOAD_DIR=./data/uploads
MAX_RETRY=2
